<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.ailintouch.hud</string>
	<key>CFBundleExecutable</key>
	<string>AilinHUD</string>
	<key>CFBundleName</key>
	<string>AilinHUD</string>
	<key>CFBundleDisplayName</key>
	<string>AilinHUD</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.8.42</string>
	<key>CFBundleVersion</key>
	<string>1.8.42</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- ★ v1.8.1 关键：无 UIApplicationSceneManifest = legacy 模式 →
	     UIApplicationMain 不等 scene 连接 → 不卡 booting（v1.5.0 共享
	     bundle + SceneManifest 卡死的根因）。悬浮球窗口由 didFinish
	     手动创建 + FBSceneManager 二进制 scene + binder（懒人 RootCore 同款） -->
	<!-- daemon 化：SpringBoard 不把它当普通前台 App -->
	<key>SBAppIsDaemon</key>
	<true/>
	<key>HideAtLaunch</key>
	<true/>
	<key>SpringBoard</key>
	<dict>
		<key>Hide</key>
		<true/>
		<key>Background</key>
		<true/>
		<key>LaunchAtBoot</key>
		<true/>
		<key>RestartAfterCrash</key>
		<true/>
	</dict>
	<key>BSServiceDomains</key>
	<dict>
		<key>com.apple.frontboard</key>
		<dict>
			<key>DerivedServiceRestrictions</key>
			<array>
				<string>com.apple.uis.applicationStateService</string>
				<string>com.apple.frontboard.layout-monitor</string>
			</array>
			<key>Services</key>
			<dict>
				<key>com.apple.frontboard.system-service</key>
				<dict/>
				<key>com.apple.frontboard.workspace-service</key>
				<dict/>
			</dict>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
</dict>
</plist>
