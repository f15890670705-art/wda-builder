	<!-- ========== 后台常驻（懒人同款：daemon 化，launchd 管，iOS 不杀） ========== -->
	<key>SBAppIsDaemon</key>
	<true/>
	<key>HideAtLaunch</key>
	<true/>
	<key>SpringBoard</key>
	<dict>
		<key>Hide</key>
		<true/>
		<key>Background</key>
		<true/>
		<key>LaunchAtBoot</key>
		<true/>
		<key>RestartAfterCrash</key>
		<true/>
	</dict>

	<!-- ★ v1.5.2 铁证：懒人(RootService) 的 BSServiceDomains 结构（照原样抄）——
	     DerivedServiceRestrictions 是数组（字符串列表），Services 的值是空 dict {}。
	     v1.5.2 第一版抄错成嵌套 dict+true，可能导致 FrontBoard 服务注册异常。 -->
	<key>BSServiceDomains</key>
	<dict>
		<key>com.apple.frontboard</key>
		<dict>
			<key>DerivedServiceRestrictions</key>
			<array>
				<string>com.apple.uis.applicationStateService</string>
				<string>com.apple.frontboard.layout-monitor</string>
				<string>com.ailintouch.backgroundService</string>
				<string>com.ailintouch.networkService</string>
				<string>com.ailintouch.startupService</string>
			</array>
			<key>Services</key>
			<dict>
				<key>com.apple.frontboard.system-service</key>
				<dict/>
				<key>com.ailintouch.network-service</key>
				<dict/>
				<key>com.apple.frontboard.workspace-service</key>
				<dict/>
				<key>com.ailintouch.background-service</key>
				<dict/>
			</dict>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>external-accessory</string>
		<string>fetch</string>
